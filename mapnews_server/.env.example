# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env

# Режим запуска: development или production
# В production режиме devCode НЕ возвращается в ответе API
NODE_ENV=development

# Порт сервера
PORT=8080

# MongoDB URI (замените на свою строку подключения)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/news

# Секрет для подписи JWT (замените на длинную случайную строку)
JWT_SECRET=замените_на_случайный_секрет_минимум_32_символа

# SMTP настройки для отправки писем с кодом подтверждения
# Если не заданы — коды выводятся только в консоль сервера (только в development)

# Для Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
SMTP_FROM="MapNews <your@gmail.com>"

SITE_URL=https://yourdomain.com
